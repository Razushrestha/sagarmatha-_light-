PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=3016
HOST=0.0.0.0
NODE_ENV=production
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DB=sagarmatha_light_solution
MONGODB_URI=mongodb://127.0.0.1:27017/sagarmatha_light_solution
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
IMPERSONATE_MINUTES=30
FRONTEND_URL=http://YOUR_SERVER_IP:3016
CORS_ORIGINS=
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_MAX=800
ENABLE_STARTUP_SYNC=false
MONGO_POOL_SIZE=20
MONGO_MIN_POOL=0
MONGO_READ_PREFERENCE=primary
MONGO_SLOW_MS=150
REDIS_URL=redis://127.0.0.1:6379
REDIS_DISABLED=false
JOB_WORKER=true
JOB_CONCURRENCY=2
IMAGE_MAX_PX=1280
IMAGE_THUMB_PX=320
IMAGE_WEBP_QUALITY=78
# Scale: extra API processes set JOB_WORKER=false. Run one worker with JOB_WORKER=true.
# Ops paging (Telegram and/or email). Armed in production, or set ALERTS_ENABLED=true.
ALERTS_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_REDIS_DOWN_MS=300000
ALERT_DISK_PERCENT=80
ALERT_MONGO_SLOW_COUNT=10
ALERT_BACKUP_AFTER_HOUR=8
BACKUP_DIR=
BACKUP_KEEP=14
# Replica set example: MONGODB_URI=mongodb://127.0.0.1:27017,127.0.0.1:27018/sagarmatha_light_solution?replicaSet=rs0
# Then MONGO_READ_PREFERENCE=secondaryPreferred for dashboard reads.
